{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source":"~/.config/fastfetch/logo.txt",
        "type": "file",
        "padding": {
            "left": 3,
            "top": 1
        }
    },
    "display": {
        "separator": "  ",
        "constants": [
            "───────────────────────────" // {$1}, used in Custom module
        ],
        "key": {
            "type": "icon",
            "paddingLeft": 2
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            // {#1} is equivalent to `\u001b[1m`. {#} is equivalent to `\u001b[m`
            "format": "{#38;2;245;194;231}┌{$1} {#1}Hardware {$1}┐{#}"
        },
        // "host",
        "cpu",
        "gpu",
        "disk",
        "memory",
        "swap",
        "display",
        "brightness",
        "battery",
        "poweradapter",
        "bluetooth",
        "sound",
        "gamepad",
        {
            "type": "custom",
            "format": "{#38;2;245;194;231}└{$1}──────────{$1}┘{#}"
        },
        // "break",
        {
            "type": "custom", // SoftwareStart
            "format": "{#38;2;245;194;231}┌{$1} {#1}Software {$1}┐{#}"
        },
        {
            "type": "title",
            "keyIcon": "",
            "key": "Title", // Title module has no key by default, so that icon is not displayed
            "format": "{user-name}@{host-name}"
        },
        "os",
        "kernel",
        "initsystem",
        "de",
        "wm",
        "shell",
        "terminal",
        "packages",
        "uptime",
        "media",
        "localip",
        {
            "type": "command",
            "text": "init=$(stat -c %W /); current=$(date +%s); difference=$((current - init)); days=$((difference / 86400)); echo $days days"
        },
        {
            "type": "custom",
            "format": "{#38;2;245;194;231}└{$1}──────────{$1}┘{#}"
        },
        // {
        //     "type": "custom",
        //     // {#1} is equivalent to `\u001b[1m`. {#} is equivalent to `\u001b[m`
        //     "format": "{#38;2;245;194;231}┌{$1} {#1}GNU/World {$1}┐{#}"
        // },
        // {
        //   "type": "weather",
        //   "timeout": 1000
        // },
        // {
        //     "type": "custom",
        //     "format": "{#38;2;245;194;231}└{$1}──────────{$1}┘{#}"
        // }
    ]
}


# super/meta/win key
set $mod Mod4

# set $scaling_factor 1
# output DP-1 scale 3.141592
# output DP-1 scale_filter smart
output DP-1 adaptive_sync on
# output DP-1 resolution 1920x1080
output DP-1 mode 2560x1440@165Hz
# output DP-1 mode 1920x1080@120Hz
# exec_always ---no-startup-id xwayland-scale --scale=$scaling_factor

# output * bg ~/entity.jpg fill

# mqaybe
# corner_radius 5

# exec_always swaybg -i ~/glorious\ leo.jpg
exec autotiling-rs

seat seat0 xcursor_theme catppuccin-mocha-pink-cursors

# move focused to scratchpad
bindsym $mod+Shift+minus move scratchpad

# show next scratchpad thing
# idfk if its fifo queue its 10:25 im going insane
bindsym $mod+minus scratchpad show

# nice (no not the priority thing)
# not nice.
bindsym $mod+Shift+s exec grim - | wl-copy --type image/png && notify-send low "screenshot taken"
bindsym print exec wl-copy --type image/png < <(grim -g "$(slurp)" -)
bindsym Shift+print exec grim -g "$(slurp)" "$(xdg-user-dir)"/Pictures/$(date +'screenshot_%d-%m-%Y-%H%M%S.png')
# bindsym Print exec flameshot gui

# font for window titles in tabbed or stacked mode, or whenever its visible.
font pango:Lexend 11

# Start XDG autostart .desktop files using dex. See also
# https://wiki.archlinux.org/index.php/XDG_Autostart
# exec --no-startup-id dex --autostart --environment sway
# exec mako
exec swaync
# ARTIX FIX: systemd --user handled this originally.
exec pipewire
exec pipewire-pulse
exec wireplumber
# exec activate-linux
exec foot -s
exec ~/.config/sway/init.sh

bindsym $mod+a exec swaync-client -t

# Use pactl to adjust volume in PulseAudio.
# set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# start a terminal
# bindsym $mod+Return exec i3-sensible-terminal
bindsym $mod+Return exec footclient
# evil hack for $TERM for this specific foot terminal that doesn't launch tmux by default
# (allow using tmux attach/detach etc)
bindsym $mod+t exec footclient --term=kitty /bin/fish
bindsym $mod+b exec "gio launch /usr/share/applications/floorp.desktop"
# bindsym $mod+Return exec kitty

# kill focused window
bindsym $mod+Shift+q kill

# bindsym $mod+d exec "rofi -modi drun,run -show drun"
bindsym $mod+d exec "ignition"

bindsym $mod+Alt+q exec ~/.config/sway/lock.sh
bindsym $mod+Shift+o exec "swaymsg output DP-1 dpms off"
bindsym $mod+Shift+p exec "swaymsg output DP-1 dpms on"

# focus on windows
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+H focus left
bindsym $mod+J focus down
bindsym $mod+K focus up
bindsym $mod+L focus right

# move focused window
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+H move left
bindsym $mod+Shift+J move down
bindsym $mod+Shift+K move up
bindsym $mod+Shift+L move right

# split in vertical orientation
bindsym $mod+v split v

bindsym $mod+m exec "killall -SIGUSR1 waybar"
bindsym $mod+p exec "wleave"

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# # change container layout (stacked, tabbed, toggle split)
# bindsym $mod+s layout stacking
# bindsym $mod+w layout tabbed
# bindsym $mod+e layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r exec "swaymsg reload"
bindsym $mod+Shift+e exec "swaynag -t warning -m 'Log off?' -B 'Send me back to the tty!' 'sway exit'"

bar {
    # this shit bloated as hell what the fuck
    swaybar_command waybar
}

# Color shemes for windows 
set $bgcolor	#1e1e2e99
set $in-bgcolor #0000004d
set $text	    #11111b
set $u-bgcolor	#fab387
set $in-text	#cdd6f4

set $bordercolor-app #f5c2e7

#			border		background	text		indicator (a line which shows where the next window will be placed)	
client.focused		$bordercolor-app	$bordercolor-app	$bordercolor-app		$bordercolor-app
client.unfocused	$in-bgcolor	$in-bgcolor	$in-text	$in-bgcolor
client.focused_inactive	$in-bgcolor	$in-bgcolor	$in-text	$in-bgcolor
client.urgent		$u-bgcolor	$u-bgcolor	$text		$u-bgcolor	

# key bindings for Media control keys
bindsym XF86AudioPlay exec playerctl play
bindsym XF86AudioPause exec playerctl pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +5%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-

# non-adjustable gaps because you don't need to adjust it, obviously
gaps inner 4
gaps outer 0

include ~/.config/sway/conf.d/*

